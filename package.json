    "allure:generate": "allure generate allure-results -o allure-report --clean",
    "telegram-report": "java \"-DconfigFile=notifications/config.json\" -jar \"notifications/allure-notifications-5.0.2.jar\"",
    "test:full": "npm run test && npm run allure:generate && npm run telegram-report"
  },
